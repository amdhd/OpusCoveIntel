# -- secrets -------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# -- python --------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# -- tooling caches ------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# uv.lock is deliberately NOT ignored. This is an application, not a library:
# the lockfile is what makes a build reproducible, so CI, Docker and a new
# laptop all resolve the same versions. Ignoring it means an upstream release
# can turn CI red with no change on our side, and a green run cannot be
# reproduced later.

# -- runtime data --------------------------------------------------------
# Ingested documents, object storage and eval output all land here.
var/
*.db
*.sqlite3

# -- corpus --------------------------------------------------------------
# Real prospectuses are copyrighted -- synthetic fixtures only (CLAUDE.md 7).
data/real/
*.pdf
!tests/fixtures/**/*.pdf

# -- frontend ------------------------------------------------------------
# `package-lock.json` is deliberately NOT ignored, for the same reason as
# uv.lock: it is what makes the client build reproducible.
frontend/node_modules/
frontend/dist/
frontend/.angular/
# Unanchored as well, so an `npm install` run from the repo root -- or from a
# second client added later -- cannot commit a dependency tree.
node_modules/

# -- editors / os --------------------------------------------------------
.vscode/
.idea/
.DS_Store

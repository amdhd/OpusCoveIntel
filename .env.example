# OpusCovIntel configuration
# Copy to `.env` and fill in. NEVER commit `.env`.

# -- application ---------------------------------------------------------
ENVIRONMENT=local                 # local | test | staging | production
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR | CRITICAL

# -- database ------------------------------------------------------------
# Host ports as seen from your machine. Inside compose, the host is `db`.
DATABASE_URL=postgresql+asyncpg://opuscovintel:opuscovintel@localhost:5432/opuscovintel
# Read-only role. CLAUDE.md 1.6 -- the query agent uses this and only this.
DATABASE_URL_RO=postgresql+asyncpg://opuscovintel_ro:opuscovintel_ro@localhost:5432/opuscovintel
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=10
DB_ECHO=false
DB_STATEMENT_TIMEOUT_MS=5000

# -- object storage ------------------------------------------------------
# Local filesystem for the MVP; S3/MinIO deferred to Phase 8.
STORAGE_DIR=./var/storage

# -- retrieval -----------------------------------------------------------
# Qwen text-embedding-v4. Changing this forces a full re-embed + index rebuild.
VECTOR_DIMENSION=1024

# -- llm providers -------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Model IDs. Verify against provider docs before changing.
EXTRACTION_MODEL=claude-opus-5
SYNTHESIS_MODEL=claude-opus-5
JUDGE_MODEL=claude-opus-5
CHEAP_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v4
VLM_MODEL=gpt-4o

# -- budget guards (PLAN.md 2) -------------------------------------------
# These are hard stops, not warnings. A breach aborts the stage.
MAX_COST_PER_DOCUMENT_USD=2.00
MAX_TOTAL_COST_USD=200.00
MAX_COST_PER_CALL_USD=0.50
MAX_VLM_PAGES_PER_DOC=40

# -- ingestion limits ----------------------------------------------------
MAX_UPLOAD_SIZE_MB=100
MAX_PDF_PAGES=600

# -- extraction ----------------------------------------------------------
DEFAULT_CONFIDENCE_THRESHOLD=0.85
CITATION_FUZZY_THRESHOLD=0.92

# -- authentication ------------------------------------------------------
SESSION_COOKIE_NAME=opuscovintel_session
SESSION_TTL_HOURS=12
# Must be true wherever the app is served over HTTPS. Settings refuses to
# start a production with it off.
SESSION_COOKIE_SECURE=false

# -- login rate limiting -------------------------------------------------
# Failed attempts are counted per username and per client IP; past the
# threshold each further attempt waits base * 2^n seconds, capped. There is no
# off switch, and no lockout -- see app/auth/rate_limit.py for why.
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_MAX_FAILURES_PER_USERNAME=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_BACKOFF_BASE_SECONDS=2
LOGIN_BACKOFF_MAX_SECONDS=900
LOGIN_ATTEMPT_RETENTION_HOURS=24

# -- feature flags -------------------------------------------------------
# Setting this to false makes every request run as a single fixed local
# identity, with no login. It exists for offline demos; Settings refuses to
# start with it off when ENVIRONMENT=production.
AUTH_ENABLED=true
AUDIT_ENABLED=true

# -- tests ---------------------------------------------------------------
# Set to 1 to allow tests marked `live_llm` to hit real, BILLABLE providers.
# Leave unset in CI.
# RUN_LIVE_LLM_TESTS=1
